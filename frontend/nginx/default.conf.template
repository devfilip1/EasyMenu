# Production server for the EasyMenu SPA (research R15 and R18).
# Rendered by the nginx image entrypoint (envsubst) into /etc/nginx/conf.d/default.conf.
# Only defined environment variables are substituted (API_UPSTREAM, required; see
# docker-entrypoint.d/05-require-api-upstream.sh); nginx variables such as $uri are untouched.
#
# Same origin (R18): /api/, /hubs/ and /media/ are proxied to the API, so the browser only ever
# talks to this origin and the CSP needs no external source.

# WebSocket upgrade for SignalR (/hubs/): "upgrade" when the client asks for it, "close" otherwise.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    charset utf-8;

    gzip on;
    gzip_vary on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Item photos are up to 5 MB (Storage:MaxImageBytes); leave room for the multipart envelope.
    client_max_body_size 6m;

    # Security headers. Declared once at server level: locations below must not use add_header,
    # otherwise nginx stops inheriting these (they use `expires` for caching instead).
    # script-src 'self' works because the build has no inline scripts (inlineCritical disabled).
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # Headers sent to the API on every proxied request (ForwardedHeaders on the API side).
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;

    # REST API. `^~` keeps the asset regex below from catching API paths.
    location ^~ /api/ {
        proxy_pass ${API_UPSTREAM};
    }

    # SignalR hubs: WebSocket upgrade and long-lived connections.
    location ^~ /hubs/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_buffering off;
    }

    # Uploaded item photos, served by the API.
    location ^~ /media/ {
        proxy_pass ${API_UPSTREAM};
    }

    # SPA fallback: client-side routes (/login, /m/{slug}, ...) are served by index.html.
    location / {
        try_files $uri /index.html;
    }

    # index.html is never cached, so a deploy is picked up on the next navigation.
    location = /index.html {
        expires -1;
    }

    # Hashed bundles (outputHashing: all) are immutable.
    location ~* "-[A-Z0-9]{8}\.(?:js|css)$" {
        expires 1y;
        try_files $uri =404;
    }
}
