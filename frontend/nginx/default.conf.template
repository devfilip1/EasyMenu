# Production server for the EasyMenu SPA (research R15).
# Rendered by the nginx image entrypoint (envsubst) into /etc/nginx/conf.d/default.conf.
# Only defined environment variables are substituted: API_ORIGIN and API_WS_ORIGIN
# (defaults in the Dockerfile); nginx variables such as $uri are left untouched.

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    charset utf-8;

    gzip on;
    gzip_vary on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Security headers. Declared once at server level: locations below must not use add_header,
    # otherwise nginx stops inheriting these (they use `expires` for caching instead).
    # script-src 'self' works because the build has no inline scripts (inlineCritical disabled).
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: ${API_ORIGIN}; connect-src 'self' ${API_ORIGIN} ${API_WS_ORIGIN}; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # SPA fallback: client-side routes (/login, /m/{slug}, ...) are served by index.html.
    location / {
        try_files $uri /index.html;
    }

    # index.html is never cached, so a deploy is picked up on the next navigation.
    location = /index.html {
        expires -1;
    }

    # Hashed bundles (outputHashing: all) are immutable.
    location ~* "-[A-Z0-9]{8}\.(?:js|css)$" {
        expires 1y;
        try_files $uri =404;
    }
}
